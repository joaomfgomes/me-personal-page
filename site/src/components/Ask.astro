---
import { site } from '../site.config';
---
<section class="ask" aria-label="Ask a question about my work" data-endpoint={site.askEndpoint}>
  <form id="ask-form">
    <label for="ask-input" class="visually-hidden">Ask a question about my work</label>
    <input id="ask-input" type="text" placeholder="Ask a question about my work" autocomplete="off" maxlength="300" />
    <button id="ask-submit" type="submit">Ask</button>
  </form>
  <p class="try">
    Try: {site.askQuestions.map((q, i) => <>{i > 0 && ', '}<button type="button" data-q={q}>{q}</button></>)}
  </p>
  <div class="answer" id="ask-out" aria-live="polite" hidden></div>
</section>

<script>
  import { searchIndex } from '../lib/search';

  const box = document.querySelector<HTMLElement>('.ask')!;
  const endpoint = box.dataset.endpoint ?? '';
  const form = document.getElementById('ask-form') as HTMLFormElement;
  const input = document.getElementById('ask-input') as HTMLInputElement;
  const submit = document.getElementById('ask-submit') as HTMLButtonElement;
  const out = document.getElementById('ask-out')!;

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const sources = (items: { title: string; url: string }[]) =>
    `<ol>${items.map((s) => `<li><a href="${esc(s.url)}">${s.title}</a></li>`).join('')}</ol>`;

  async function ask(q: string) {
    out.hidden = false;
    submit.disabled = true;
    out.innerHTML = '<p>Looking through my notes…</p>';
    try {
      if (endpoint) {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question: q }),
        });
        if (!res.ok) throw new Error(String(res.status));
        const data = await res.json();
        const src = (data.sources ?? []).map((s: { title: string; url: string }) => ({ title: esc(s.title), url: s.url }));
        out.innerHTML = `<p>${esc(data.answer ?? '')}</p>${src.length ? sources(src) : ''}`;
      } else {
        const hits = await searchIndex(q, 4);
        out.innerHTML = hits.length
          ? `<p>I write about that here:</p>${sources(hits)}`
          : '<p>I haven’t written about that yet. Email me and ask directly.</p>';
      }
    } catch {
      out.innerHTML = '<p>The answer service isn’t responding. Use Search, or email me.</p>';
    } finally {
      submit.disabled = false;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (q) ask(q); else input.focus();
  });
  box.querySelectorAll<HTMLButtonElement>('[data-q]').forEach((b) =>
    b.addEventListener('click', () => { input.value = b.dataset.q!; ask(b.dataset.q!); }),
  );
</script>
