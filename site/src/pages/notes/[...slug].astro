---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
import { fmtDate } from '../../lib/format';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((n) => !n.data.draft);
  return notes.map((n) => ({ params: { slug: n.id }, props: { n } }));
}
const { n } = Astro.props;
const { Content } = await render(n);
const minutes = Math.max(1, Math.round((n.body ?? '').split(/\s+/).length / 230));
---
<Base title={n.data.title} description={n.data.summary}>
  <article>
    <a class="back" href="/notes">← All notes</a>
    <h1 class="title">{n.data.title}</h1>
    <p class="date"><time datetime={n.data.date.toISOString()}>{fmtDate(n.data.date)}</time> · {minutes} min read</p>
    <div class="prose"><Content /></div>
  </article>
  <Contact />
</Base>
