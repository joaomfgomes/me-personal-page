---
import { getCollection } from 'astro:content';
import { site } from '../site.config';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    title: p.data.title,
    url: `/projects/${p.id}`,
    line: (p.data.result ?? p.data.summary).replace(/\*\*(.+?)\*\*/g, '$1'),
  }));
const profile = {
  name: site.name,
  role: site.role,
  location: site.location,
  intro: site.intro.map((h) => h.replace(/<[^>]+>/g, '')),
  about: site.aboutShort,
  howIWork: site.howIWork,
  availability: site.availability,
  now: site.now.items,
  email: site.email,
  replyPromise: site.replyPromise,
  links: site.links,
  projects,
};
---
<section class="hero" aria-labelledby="ask-title" data-endpoint={site.askEndpoint} data-profile={JSON.stringify(profile)} data-placeholders={JSON.stringify(site.askPlaceholders)}>
  <h1 id="ask-title">{site.askTitle}</h1>
  <p class="sub">{site.askSubtitle}</p>

  <form class="composer" id="ask-form">
    <label for="ask-input" class="visually-hidden">Your question</label>
    <textarea id="ask-input" rows="2" maxlength="400" placeholder={site.askPlaceholders[0]}></textarea>
    <div class="row">
      <span class="hint">Press Enter to ask</span>
      <button class="send" id="ask-send" type="submit" aria-label="Ask">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
      </button>
    </div>
  </form>

  <div class="chips">
    {site.askChips.map((c) => <button class="chip" type="button" data-q={c.q}>{c.label}</button>)}
  </div>

  <div class="answer" id="ask-out" aria-live="polite" hidden></div>
  <a class="scroll-cue" href="#projects">Or scroll for projects and notes ↓</a>
</section>

<script>
  import { searchIndex } from '../lib/search';

  type Profile = {
    name: string; role: string; location: string; intro: string[]; about: string[]; howIWork: string;
    availability: string; now: string[]; email: string; replyPromise: string;
    links: { github: string; linkedin: string; cv: string };
    projects: { title: string; url: string; line: string }[];
  };

  const hero = document.querySelector<HTMLElement>('.hero')!;
  const endpoint = hero.dataset.endpoint ?? '';
  const profile: Profile = JSON.parse(hero.dataset.profile ?? '{}');
  const placeholders: string[] = JSON.parse(hero.dataset.placeholders ?? '[]');
  const form = document.getElementById('ask-form') as HTMLFormElement;
  const input = document.getElementById('ask-input') as HTMLTextAreaElement;
  const send = document.getElementById('ask-send') as HTMLButtonElement;
  const out = document.getElementById('ask-out')!;

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const p = (s: string) => `<p>${esc(s)}</p>`;
  const link = (url: string, text: string) => `<a href="${esc(url)}">${esc(text)}</a>`;

  // Rotating placeholder, like the example prompts on openai.com.
  let i = 0;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rotate = setInterval(() => {
    if (document.activeElement === input || input.value) return;
    i = (i + 1) % placeholders.length;
    input.placeholder = placeholders[i];
  }, reduce ? 6000 : 3200);

  // Grow the textarea with its content; switch the send button on.
  const sync = () => {
    input.style.height = 'auto';
    input.style.height = `${Math.min(input.scrollHeight, 200)}px`;
    send.classList.toggle('ready', input.value.trim().length > 0);
  };
  input.addEventListener('input', sync);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
  });

  // "Junior AI engineer" -> "junior AI engineer"; leaves acronyms like "AI engineer" alone.
  const lowerFirst = (s: string) => (/^[A-Z][a-z]/.test(s) ? s.charAt(0).toLowerCase() + s.slice(1) : s);
  const article = (s: string) => (/^[aeiou]/i.test(s) ? 'an' : 'a');

  // Answers written from the site's own content, for questions about me.
  const has = (q: string, words: string[]) => words.some((w) => q.includes(w));
  function localAnswer(raw: string): string | null {
    const q = raw.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    if (has(q, ['contact', 'reach', 'email', 'hire', 'talk', 'contacto', 'contactar', 'falar', 'contratar', 'linkedin'])) {
      return p(`The fastest way is email: ${profile.email}. ${profile.replyPromise}`) +
        `<p>You can also message me on ${link(profile.links.linkedin, 'LinkedIn')} or read my ${link(profile.links.cv, 'CV')}.</p>`;
    }
    if (has(q, ['open to', 'looking for', 'available', 'job', 'role', 'emprego', 'vaga', 'disponivel', 'procura'])) {
      return p(profile.availability || 'I’m not looking for a new role right now, but I’m always happy to talk.') +
        `<p>${link('#contact', 'Here’s how to reach me.')}</p>`;
    }
    if (has(q, ['learn', 'now', 'reading', 'currently', 'these days', 'aprender', 'agora', 'neste momento', 'estudar'])) {
      return `<p>This month I’m focused on:</p><ul>${profile.now.map((n) => `<li>${esc(n)}</li>`).join('')}</ul>` +
        `<p>${link('/now', 'More on my Now page')}</p>`;
    }
    if (has(q, ['how do you work', 'how you work', 'approach', 'process', 'como trabalhas', 'metodo'])) {
      return p(profile.howIWork) + `<p>${link('/about', 'More about me')}</p>`;
    }
    if (has(q, ['built', 'build', 'projects', 'project', 'portfolio', 'work on', 'projetos', 'construiste', 'fizeste'])) {
      return `<p>Here’s what I’ve built so far:</p><ul>${profile.projects
        .map((pr) => `<li>${link(pr.url, pr.title)}: ${esc(pr.line)}</li>`)
        .join('')}</ul>`;
    }
    if (has(q, ['outside work', 'hobby', 'hobbies', 'free time', 'fun', 'tempo livre', 'fora do trabalho'])) {
      return p(profile.about[profile.about.length - 1]);
    }
    if (has(q, ['who are you', 'about you', 'yourself', 'background', 'your story', 'quem es', 'quem e', 'sobre ti', 'percurso'])) {
      return p(`I’m ${profile.name}, ${article(profile.role)} ${lowerFirst(profile.role)} in ${profile.location}.`) +
        profile.about.slice(0, 1).map(p).join('') + `<p>${link('/about', 'More about me')}</p>`;
    }
    return null;
  }

  async function ask(q: string) {
    out.hidden = false;
    out.innerHTML = `<p class="q">${esc(q)}</p><p>Thinking…</p>`;
    send.disabled = true;
    try {
      let html: string | null = null;
      if (endpoint) {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question: q }),
        });
        if (!res.ok) throw new Error(String(res.status));
        const data = await res.json();
        const src: { title: string; url: string }[] = data.sources ?? [];
        html = p(data.answer ?? '') + (src.length ? `<ul>${src.map((s) => `<li>${link(s.url, s.title)}</li>`).join('')}</ul>` : '');
      } else {
        html = localAnswer(q);
        if (!html) {
          const hits = await searchIndex(q, 4);
          html = hits.length
            ? `<p>I write about that here:</p><ul>${hits.map((h) => `<li><a href="${esc(h.url)}">${h.title}</a></li>`).join('')}</ul>`
            : p(`I haven’t written about that yet. Ask me directly at ${profile.email}.`);
        }
      }
      out.innerHTML = `<p class="q">${esc(q)}</p>${html}`;
    } catch {
      out.innerHTML = `<p class="q">${esc(q)}</p>${p(`I couldn’t get an answer right now. Try again, or email me at ${profile.email}.`)}`;
    } finally {
      send.disabled = false;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (!q) { input.focus(); return; }
    clearInterval(rotate);
    ask(q);
  });
  hero.querySelectorAll<HTMLButtonElement>('[data-q]').forEach((b) =>
    b.addEventListener('click', () => {
      input.value = b.dataset.q!;
      sync();
      clearInterval(rotate);
      ask(b.dataset.q!);
    }),
  );
</script>
