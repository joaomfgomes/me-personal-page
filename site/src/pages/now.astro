---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { fmtDate } from '../lib/format';
---
<Base title="Now" description="What I’m focused on this month.">
  <h1 class="title" style="margin-top:0">Now</h1>
  <p class="date">Updated {fmtDate(new Date(site.now.updated))}</p>
  <div class="prose">
    <ul>{site.now.items.map((i) => <li>{i}</li>)}</ul>
    <p>This is a <a href="https://nownownow.com/about">now page</a>: what has my attention this month.</p>
  </div>
</Base>
