---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import { site } from '../site.config';
---
<Base title="About" description={`About ${site.name}: background, what I work on, and how to reach me.`}>
  <h1 class="title" style="margin-top:0">About</h1>
  <div class="prose">
    {site.portrait && <img src={site.portrait} alt={`Portrait of ${site.name}`} width="160" height="160" style="border-radius:6px" />}
    {site.aboutShort.map((para) => <p>{para}</p>)}
    <h2>How I work</h2>
    <p>{site.howIWork}</p>
    <h2>What I’m looking for</h2>
    <p>{site.availability || 'I’m not looking for a new role right now, but I’m always glad to talk shop.'} Ideally on a team that ships LLM features to real users and takes evaluation seriously.</p>
  </div>
  <Contact />
</Base>
