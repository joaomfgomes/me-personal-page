---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.tagline } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);

const notes = (await getCollection('notes')).filter((n) => !n.data.draft);
const projects = await getCollection('projects');
const nav = [
  { href: '/projects', label: 'Projects' },
  { href: '/notes', label: 'Notes' },
  { href: '/about', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!site.indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171717" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}'s notes`} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400..700;1,400&display=swap" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="top">
      <p class="name"><a href="/">{site.name}</a></p>
      <nav aria-label="Main">
        {nav.map((n) => (
          <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
        <button class="plain-btn" id="search-btn" type="button" title="Search (⌘K)">Search</button>
        <button class="plain-btn" id="theme-btn" type="button" aria-label="Switch light or dark theme">☾</button>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <p>{notes.length} notes and {projects.length} projects so far.</p>
      <p>
        {[
          { href: site.links.github, label: 'GitHub' },
          { href: site.links.linkedin, label: 'LinkedIn' },
          { href: '/now', label: 'Now' },
          { href: '/rss.xml', label: 'RSS' },
          { href: '/llms.txt', label: 'llms.txt' },
        ].map((l, i) => <>{i > 0 && ' · '}<a href={l.href}>{l.label}</a></>)}
      </p>
    </footer>

    <dialog class="search" id="search" aria-label="Search the site">
      <input id="search-input" type="search" placeholder="Search notes and projects" autocomplete="off" />
      <ul id="search-results" role="listbox"></ul>
      <div class="search-foot">Arrow keys to move, Enter to open, Esc to close.</div>
    </dialog>

    <script>
      import { searchIndex } from '../lib/search';

      const root = document.documentElement;
      document.getElementById('theme-btn')?.addEventListener('click', () => {
        const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });

      const dialog = document.getElementById('search') as HTMLDialogElement;
      const input = document.getElementById('search-input') as HTMLInputElement;
      const list = document.getElementById('search-results') as HTMLUListElement;
      let selected = 0;

      const render = async () => {
        selected = 0;
        if (!input.value.trim()) {
          list.innerHTML = '<li class="empty">Type to search everything on this site.</li>';
          return;
        }
        const hits = await searchIndex(input.value, 8);
        list.innerHTML = hits.length
          ? hits
              .map(
                (h, i) =>
                  `<li><a href="${h.url}" role="option" aria-selected="${i === 0}"><span class="kind">${h.kind === 'note' ? 'Note' : 'Project'}</span><span class="t">${h.title}</span><span class="s">${h.summary}</span></a></li>`,
              )
              .join('')
          : '<li class="empty">Nothing matches that yet. Try fewer words.</li>';
      };
      const open = () => { dialog.showModal(); input.select(); render(); };
      document.getElementById('search-btn')?.addEventListener('click', open);
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); open(); }
      });
      input.addEventListener('input', render);
      input.addEventListener('keydown', (e) => {
        const links = [...list.querySelectorAll('a')];
        if (!links.length) return;
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          selected = (selected + (e.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length;
          links.forEach((a, i) => a.setAttribute('aria-selected', String(i === selected)));
          links[selected].scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'Enter') {
          e.preventDefault();
          links[selected].click();
        }
      });
      dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    </script>
  </body>
</html>
